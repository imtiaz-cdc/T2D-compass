ALZ_COMPASS_DATA_MODE=live
MCP_TRANSPORT=stdio
# For local public snapshot replay: ALZ_COMPASS_DATA_MODE=snapshot
# Type 2 Diabetes is the fixed disease scope. ALZ_COMPASS_* names remain compatible.
# Default snapshot manifest: data/type2diabetes/manifest.json
# For Type 2 diabetes agent scenarios: ALZ_COMPASS_MANIFEST=<absolute path to data/type2diabetes/manifest-agent.json>
# Agent credentials belong in your process environment, never in committed files.
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# Browser assistant uses the Databricks app user's forwarded OAuth token.
# Add ai-gateway in the app's User authorization settings and consent in browser.
ALZ_COMPASS_MODEL=models.ai.gpt-5-6-luna
# The following token settings apply only to the legacy external CLI runner.
# DATABRICKS_TOKEN=<set locally through your approved authentication method>
# Optional remote MCP: ALZ_COMPASS_MCP_TOKEN=<short-lived caller token>
